{
  "$schema":"https://getcomposer.org/schema.json",
  "name":"iestppd/siga-ae",
  "type":"project",
  "description":"Sistema Integrado Web para Control de Asistencia y Evaluaciones Academicas",
  "require":{"php":"^8.2","laravel/framework":"^12.0","laravel/sanctum":"^4.0","barryvdh/laravel-dompdf":"^3.1"},
  "require-dev":{
    "fakerphp/faker": "^1.23",
    "laravel/tinker": "^3.2",
    "phpunit/phpunit": "^11.5"
  },
  "autoload":{"psr-4":{"App\\":"app/","Database\\Factories\\":"database/factories/","Database\\Seeders\\":"database/seeders/"}},
  "autoload-dev":{"psr-4":{"Tests\\":"tests/"}},
  "scripts":{"post-autoload-dump":["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump","@php artisan package:discover --ansi"]},
  "config":{"optimize-autoloader":true,"preferred-install":"dist","sort-packages":true,"allow-plugins":{"php-http/discovery":true}},
  "minimum-stability":"stable","prefer-stable":true
}
